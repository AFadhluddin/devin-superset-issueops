PORT=3000

GITHUB_OWNER=your-github-username
GITHUB_REPO=superset
GITHUB_TARGET_BRANCH=master
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

DEVIN_API_KEY=your-devin-api-key
DEVIN_ORG_ID=your-devin-org-id
DEVIN_CREATE_AS_USER_ID=

TRIGGER_LABEL=devin-remediate

# Optional: orchestrator posts Slack notifications directly (chat.postMessage).
# Use a Slack bot token (xoxb-...) with chat:write (and chat:write.public for
# public channels). SLACK_CHANNEL may be a channel name (#name) or ID (C...).
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#megacorp-engineering
